# Bind address (use 0.0.0.0 inside Docker)
DOCINTEL_HOST=0.0.0.0
DOCINTEL_PORT=5000
DOCINTEL_DEBUG=false

# Upload storage for PDF annotation jobs
DOCINTEL_UPLOAD_DIR=uploads

# Logging: DEBUG, INFO, WARNING, ERROR
DOCINTEL_LOG_LEVEL=INFO

# Gunicorn workers (use 1 for OCR workloads to limit memory)
WEB_CONCURRENCY=1

# Gradio UI (docker-compose ui service)
GRADIO_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Gradio -> API URL (local dev: http://127.0.0.1:5000, Docker UI service: http://api:5000)
DOCINTEL_API_URL=http://127.0.0.1:5000

# API authentication and rate limits
DOCINTEL_API_KEYS=change-me-local-dev-key
DOCINTEL_AUTH_REQUIRED=false
DOCINTEL_RATE_LIMIT_ENABLED=true

# Async jobs (Redis + RQ worker for POST /v1/pdf/structure?async=true)
DOCINTEL_REDIS_URL=redis://localhost:6379/0
DOCINTEL_JOBS_ENABLED=true
DOCINTEL_QUEUE_NAME=docintel
REDIS_PORT=6379

# LLM PDF structuring (POST /v1/pdf/structure)
# Default model: gpt-4o-mini. Get a key: https://platform.openai.com/api-keys
# Guide: https://platform.openai.com/docs/quickstart
DOCINTEL_LLM_API_KEY=
DOCINTEL_LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (Azure, local proxy, etc.)
DOCINTEL_LLM_BASE_URL=
