# Bind address (use 0.0.0.0 inside Docker)
DOCINTEL_HOST=127.0.0.1
DOCINTEL_PORT=5000
DOCINTEL_DEBUG=false

# Upload storage for PDF annotation jobs
DOCINTEL_UPLOAD_DIR=uploads

# Logging: DEBUG, INFO, WARNING, ERROR
DOCINTEL_LOG_LEVEL=INFO

# Gunicorn workers (Docker / production)
WEB_CONCURRENCY=2
