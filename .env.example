# Bind address (use 0.0.0.0 inside Docker)
DOCINTEL_HOST=0.0.0.0
DOCINTEL_PORT=5000
DOCINTEL_DEBUG=false

# Upload storage for PDF annotation jobs
DOCINTEL_UPLOAD_DIR=uploads

# Logging: DEBUG, INFO, WARNING, ERROR
DOCINTEL_LOG_LEVEL=INFO

# Gunicorn workers (use 1 for OCR workloads to limit memory)
WEB_CONCURRENCY=1

# Gradio UI (docker-compose ui service)
GRADIO_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Gradio -> API URL (local dev: http://127.0.0.1:5000, Docker UI service: http://api:5000)
DOCINTEL_API_URL=http://127.0.0.1:5000

# Docker image target: slim (default) or ocr (CPU scanned-PDF stack)
DOCINTEL_DOCKER_TARGET=slim

# API authentication and rate limits
DOCINTEL_API_KEYS=change-me-local-dev-key
DOCINTEL_AUTH_REQUIRED=false
DOCINTEL_RATE_LIMIT_ENABLED=true

# Optional OIDC (accept Bearer JWT in addition to API keys)
DOCINTEL_OIDC_ISSUER=
DOCINTEL_OIDC_AUDIENCE=
DOCINTEL_OIDC_JWKS_URL=

# Gradio client -> API key (when DOCINTEL_AUTH_REQUIRED=true)
DOCINTEL_API_KEY=

# Webhook HMAC signature for async job callbacks (optional)
DOCINTEL_WEBHOOK_SECRET=

# Object storage for job artifacts (local or s3)
DOCINTEL_STORAGE_BACKEND=local
DOCINTEL_S3_BUCKET=
DOCINTEL_S3_REGION=us-east-1
# Optional MinIO or custom S3 endpoint
DOCINTEL_S3_ENDPOINT_URL=

# Prometheus text metrics at GET /metrics?format=prometheus
DOCINTEL_PROMETHEUS_ENABLED=true

# Async jobs (Redis + RQ worker)
DOCINTEL_REDIS_URL=redis://localhost:6379/0
DOCINTEL_JOBS_ENABLED=true
DOCINTEL_QUEUE_NAME=docintel
# Redis TTL for job metadata (seconds, default 604800 = 7 days)
DOCINTEL_JOB_TTL_SECONDS=604800
# Queue heavy requests by default when Redis and a worker are running
DOCINTEL_ASYNC_DEFAULT=false
REDIS_PORT=6379

# LLM PDF structuring (POST /v1/pdf/structure)
# Switch provider with DOCINTEL_LLM_PROVIDER: ollama (default), groq, gemini, openai
DOCINTEL_LLM_PROVIDER=ollama
DOCINTEL_LLM_API_KEY=
DOCINTEL_LLM_MODEL=
# Optional override for any provider (Ollama default: http://127.0.0.1:11434/v1)
DOCINTEL_LLM_BASE_URL=

# Provider-specific keys (used when DOCINTEL_LLM_API_KEY is empty)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Defaults when DOCINTEL_LLM_MODEL is unset:
#   ollama  -> llama3.2
#   groq    -> llama-3.3-70b-versatile
#   gemini  -> gemini-2.0-flash
#   openai  -> gpt-4o-mini
